# Copy to .env in each phase folder that needs it, or source from project root.
# Never commit .env (it inherits the repo .gitignore for examples/local-model/).

# ---- Base model ----
# Hugging Face model id used by MLX-LM and llama.cpp converters.
MODEL_ID=Qwen/Qwen2.5-3B-Instruct

# ---- Data locations ----
# On the MacBook (training side). NOT inside iCloud / Dropbox.
AULA_TRAIN_ROOT=~/aula-train
RAW_DIR=${AULA_TRAIN_ROOT}/raw
SPLITS_DIR=${AULA_TRAIN_ROOT}/splits
CHECKPOINTS_DIR=${AULA_TRAIN_ROOT}/checkpoints
FUSED_DIR=${AULA_TRAIN_ROOT}/fused-model
GGUF_DIR=${AULA_TRAIN_ROOT}/gguf

# On HAOS (capture side).
HAOS_CAPTURE_DIR=/config/aula-train

# ---- Phase 2 (historical replay) ----
# Date the replay considers "now" is overridden per-run; this is just the window.
REPLAY_MONTHS=6
# Comma-separated; replay one of each kind per past date.
REPLAY_KINDS=weekday,week-end,week-start

# ---- LLM APIs ----
# Required for Phase 2 (B1 replay) and Phase 7 (E2 LLM-as-judge).
# MUST be a paid-tier key. Free-tier retains data for training.
GEMINI_API_KEY=

# ---- Inference deployment ----
# Where the trained model will run in production.
# Values: nuc | mini
INFER_TARGET=mini

# Ollama endpoint the HA integration will point at.
# NUC example:  http://nuc.local:11434
# Mac mini ex.: http://mini.local:11434
OLLAMA_HOST=http://localhost:11434

# Ollama model name + tag (bumped per retrain).
OLLAMA_MODEL=aula
OLLAMA_TAG=v1

# ---- aula-mcp ----
# Set on HAOS so the MCP server writes tool-call traces.
# AULA_MCP_TRACE_DIR=/config/aula-train

# ---- Privacy / hygiene ----
# Disable any Ollama auto-pruning that could touch your model.
OLLAMA_NOPRUNE=1
